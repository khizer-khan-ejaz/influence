# Public origin of the website (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Django API base URL used by the browser (contact form). Same-origin path in production: /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Django API base URL used by the Next.js server when rendering pages. Internal address in production.
API_INTERNAL_URL=http://localhost:8000/api/v1
